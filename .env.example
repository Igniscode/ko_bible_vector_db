# =========================
# Embedding backend
# =========================
# jina | local
EMBEDDING_PROVIDER=local

# ---- Jina API mode ----
JINA_API_KEY=
JINA_EMBED_MODEL=jina-embeddings-v3-text
JINA_EMBED_DIM=1024
JINA_EMBED_API_URL=https://api.jina.ai/v1/embeddings
JINA_MAX_RETRIES=10
JINA_RETRY_BASE_DELAY=2.0
JINA_RETRY_MAX_DELAY=90.0

# ---- Local embedding mode ----
# sentence-transformers model name or local path
LOCAL_EMBED_MODEL=jinaai/jina-embeddings-v5-text-small
LOCAL_EMBED_DEVICE=cpu
LOCAL_EMBED_BATCH_SIZE=64
LOCAL_EMBED_NORMALIZE=false

# =========================
# Qdrant
# =========================
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_PASSAGE_COLLECTION_NAME=bible_passage_collection
QDRANT_VERSES_COLLECTION_NAME=bible_verses_collection

# =========================
# Input/Output paths
# =========================
BIBLE_TXT_PATH=bible_ko.txt
PASSAGE_TEXT_STORE_PATH=data/passage_texts.json

# =========================
# Runtime / app tuning
# =========================
BATCH_SIZE=40
VECTOR_CANDIDATE_COUNT=50
FINAL_RESULT_COUNT=5

OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
TOKENIZERS_PARALLELISM=false

STATIC_PAGE_API_KEY=
SEARCH_QUERY_MAX_LEN=200
SEARCH_RATE_LIMIT_PER_MIN=10
SEARCH_CACHE_TTL_SEC=180
SEARCH_CACHE_MAX_ITEMS=500
